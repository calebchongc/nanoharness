+test "actions restart diagnostic: normal restoration versus queued frames across a connection gap" {
+    const d = @import("diagnostic_actions_restart.zig");
+    const testing = std.testing;
+    const actions_mod = @import("app_actions.zig");
+    {
+        var a: App = .init(testing.allocator, testing.io, 1);
+        defer a.deinit();
+        try d.setup(&a);
+        App.stateChanged(&a, .connected);
+        d.drain(&a);
+        try testing.expectEqual(actions_mod.Status.ready, a.actions.status);
+        try testing.expectEqual(@as(usize, 1), try d.actionCalls(&a));
+        std.debug.print("\nCONTROL: normal saved-tab restoration -> ready; ListProjectActions=1\n", .{});
+    }
+    var a: App = .init(testing.allocator, testing.io, 1);
+    defer a.deinit();
+    try d.setup(&a);
+    App.stateChanged(&a, .connected);
+    // Model replacement's synchronous disconnected transition before already
+    // queued WatchSpaces/WatchChats messages are delivered. No real engine,
+    // socket, process, window, user data, or engine.lock is accessed.
+    const saved_scene = a.engine.scene;
+    a.engine.scene = null;
+    a.engine.state = .disconnected;
+    App.stateChanged(&a, .disconnected);
+    d.drain(&a);
+    try testing.expectEqualStrings("chat", a.selected.?);
+    try testing.expectEqual(actions_mod.Status.unavailable, a.actions.status);
+    try testing.expectEqualStrings("not connected", a.actions.error_text.?);
+    std.debug.print("RESTORE DURING GAP: unavailable; exact error=not connected\n", .{});
+    a.engine.scene = saved_scene;
+    a.engine.state = .connected;
+    App.stateChanged(&a, .connected);
+    d.drain(&a);
+    @import("app_panels.zig").chatsArrived(&a);
+    actions_mod.refresh(&a);
+    d.drain(&a);
+    try testing.expect(a.engine.up());
+    try testing.expectEqual(actions_mod.Status.unavailable, a.actions.status);
+    try testing.expectEqual(@as(usize, 0), try d.actionCalls(&a));
+    std.debug.print("RECONNECTED: engine.up=true; Actions=unavailable; ListProjectActions=0\n", .{});
+    try d.captureAndRetry(&a);
+    try testing.expectEqual(@as(usize, 1), try d.actionCalls(&a));
+    std.debug.print("REAL RETRY BUTTON: Actions=ready; ListProjectActions=1\n", .{});
+}
