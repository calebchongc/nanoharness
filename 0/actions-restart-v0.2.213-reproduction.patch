+//! Synthetic issue investigation only; production behavior is unchanged.
+const std = @import("std");
+const testing = std.testing;
+const App = @import("app.zig").App;
+const actions = @import("app_actions.zig");
+
+pub const replies =
+    \\{"EngineInfo":{"deviceId":"synthetic","version":"0.2.213"},
+    \\ "EngineReady":{},"ListHarnesses":[],"ListModels":[],
+    \\ "WatchDevices":{"$items":[[]]},
+    \\ "WatchSpaces":{"$items":[[{"id":"project","deviceId":"synthetic","path":"/synthetic/project"}]]},
+    \\ "WatchChats":{"$items":[[{"id":"chat","spaceId":"project","deviceId":"synthetic","title":"Synthetic restart"}]]},
+    \\ "WatchSessions":{"$items":[[]]},
+    \\ "ListProjectActions":{"spaceId":"project","actions":[{"id":"test","name":"Test","command":"echo synthetic","icon":"test","runOnWorktreeCreate":false}]}}
+;
+
+pub fn setup(a: *App) !void {
+    a.offscreen = true;
+    a.dark = false;
+    a.settings.apply("{\"openTabs\":[\"chat\"],\"lastChatId\":\"chat\"}");
+    a.engine.scene = try std.json.parseFromSlice(std.json.Value, testing.allocator, replies, .{});
+    a.engine.state = .connected;
+}
+
+pub fn actionCalls(a: *App) !usize {
+    var count: usize = 0;
+    for (a.engine.sent.items) |frame| {
+        const parsed = try std.json.parseFromSlice(std.json.Value, testing.allocator, frame, .{});
+        defer parsed.deinit();
+        if (std.mem.eql(u8, parsed.value.object.get("method").?.string, "ListProjectActions")) count += 1;
+    }
+    return count;
+}
+
+pub fn drain(a: *App) void {
+    for (0..8) |_| _ = a.engine.pump();
+}
+
+pub fn captureAndRetry(a: *App) !void {
+    @import("theme.zig").registerFonts();
+    var t: @import("nanoui").ui.Tester = undefined;
+    try t.init(testing.allocator, .init(a, @import("view.zig").view), .{ .width = 1000, .height = 600, .dark = false, .scale = 2 });
+    defer t.deinit();
+    t.settle(0.3);
+    const anchor = a.actions.anchor orelse return error.MissingActionsToolbar;
+    t.click(anchor.x + anchor.w / 2, anchor.y + anchor.h / 2);
+    t.settle(0.3);
+    try testing.expect(t.hasText("not connected"));
+    try testing.expect(t.hasText("Retry"));
+    try t.screenshot("actions-restart-before.png");
+    try t.clickText("Retry");
+    t.settle(0.3);
+    drain(a);
+    t.settle(0.3);
+    try testing.expectEqual(actions.Status.ready, a.actions.status);
+    try testing.expect(t.hasText("Test"));
+    try t.screenshot("actions-restart-retry.png");
+}
